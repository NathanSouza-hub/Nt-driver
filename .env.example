NODE_ENV=production
PORT=3000
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria
APP_BASE_URL=https://seu-app.exemplo.com
SESSION_TABLE_NAME=user_sessions
PUBLIC_REGISTER_ENABLED=false

# Banco local no mesmo app (arquivo local)
# Use DB_CLIENT=sqlite para rodar tudo no mesmo app
DB_CLIENT=sqlite
SQLITE_FILE=/data/ntdriver.db

# Supabase PostgreSQL (use Session Pooler para IPv4)
# Formato:
# postgresql://postgres:SUA_SENHA@HOST_POOLER:6543/postgres?sslmode=require
DATABASE_URL=

# Resend (API HTTP) opcional para reset de senha e verificação de email
# Sem RESEND_API_KEY, os links são apenas logados no console.
# Gere a API key em resend.com > API Keys. Para enviar a qualquer email,
# verifique um dominio em resend.com > Domains e use um remetente dele.
# Sem dominio, onboarding@resend.dev so entrega para o dono da conta Resend.
RESEND_API_KEY=
RESEND_FROM=NT Driver <onboarding@resend.dev>
EMAIL_VERIFICATION_TOKEN_MINUTES=1440

# Cobranca via PIX (assinatura vitalicia)
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_PRICE=14.99
SUBSCRIPTION_LABEL=Acesso vitalicio NT Driver
PIX_KEY=+55SEUNUMEROOUCHAVEPIX
PIX_KEY_OWNER=SEU NOME COMPLETO
PIX_KEY_CITY=SUA CIDADE
