NODE_ENV=production
PORT=3000
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria
APP_BASE_URL=https://seu-app.exemplo.com
SESSION_TABLE_NAME=user_sessions
PUBLIC_REGISTER_ENABLED=false

# Banco local no mesmo app (Fly volume ou arquivo local)
# Use DB_CLIENT=sqlite para rodar tudo no mesmo app
DB_CLIENT=sqlite
SQLITE_FILE=/data/ntdriver.db

# Supabase PostgreSQL (use Session Pooler para IPv4)
# Formato:
# postgresql://postgres:SUA_SENHA@HOST_POOLER:6543/postgres?sslmode=require
DATABASE_URL=

# Brevo (API HTTP) opcional para reset de senha e verificação de email
# Sem essas variáveis, os links são apenas logados no console.
# Gere a API key em app.brevo.com > SMTP & API > API Keys, e verifique
# BREVO_SENDER_EMAIL em app.brevo.com > Senders, Domains & Dedicated IPs
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NT Driver
EMAIL_VERIFICATION_TOKEN_MINUTES=1440

# Cobranca via PIX (assinatura vitalicia)
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_PRICE=14.99
SUBSCRIPTION_LABEL=Acesso vitalicio NT Driver
PIX_KEY=+55SEUNUMEROOUCHAVEPIX
PIX_KEY_OWNER=SEU NOME COMPLETO
PIX_KEY_CITY=SUA CIDADE

# Alerta no WhatsApp via CallMeBot quando o usuario clicar em "Ja paguei"
# 1. Confira o numero atual de ativacao em callmebot.com (eles trocam de tempos
#    em tempos quando o numero anterior e banido pelo WhatsApp)
# 2. Salve esse numero nos seus contatos e mande a mensagem
#    "I allow callmebot to send me messages" para ele pelo WhatsApp
# 3. Aguarde a resposta com sua API key (ate 2min; se nao vier, tente de novo em 24h)
CALLMEBOT_PHONE=+55SEUNUMEROCOMDDD
CALLMEBOT_APIKEY=
